# Environment template for Socly
# Copy to .env and adjust. The install wizard can also write this file.
# System / infrastructure only — association choices go in .env.user

APP_NAME=Socly
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=socly
DB_USERNAME=socly
DB_PASSWORD=

APP_LOCALE=it
SESSION_LIFETIME=120

# Public SOCLY website (all app ↔ website API calls: news, platform, bug reports, …)
# Prefer apex host (avoids www → apex redirect on API fetches).
# Keep the public site here: never point it to the domain where this instance is
# installed (that domain has no /api/news.php and would answer 404).
SOCLY_SITE_URL=https://socly.it
# Optional override: SOCLY_PLATFORM_API_URL=https://socly.it/api/platform.php
# Optional override: SOCLY_NEWS_API_URL=https://socly.it/api/news.php
# Optional: PHP CLI used to lint add-on packages (default: resolved automatically;
# under PHP-FPM set e.g. SOCLY_PHP_BIN=/usr/bin/php if the lint must run)
# SOCLY_PHP_BIN=/usr/bin/php
# Manual + auto bug reports via platform relay (0 = hide UI / skip send)
SOCLY_REPORT_PROBLEMS=1

# Release notifications (public HTTPS manifest — no tokens or SSH required)
UPDATE_NOTIFY=true
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/dadaloop82/socly_public/main/latest.json

# One-click / scheduled update (sidebar "Update" button, bin/update.php --apply).
# In a git checkout the in-app "Update" button works out of the box: one confirmation takes a full
# backup (code archive + database dump), pulls, migrates, verifies and rolls back on failure.
# UPDATE_ENABLED=true forces the updater; false/empty keeps automatic detection (git checkout).
# Set UPDATE_DISABLED=true to turn updates off explicitly.
UPDATE_DISABLED=false
# Nightly fully-automatic update:
#   15 4 * * * php /path/to/socly/bin/update.php --apply >> /path/to/socly/storage/logs/update.log 2>&1
UPDATE_REPO=https://github.com/dadaloop82/socly_public.git
UPDATE_CHANNEL=main
# The default repository is public and read anonymously over HTTPS: no token, deploy key or SSH
# configuration is required. Only forks on a private remote need a key readable by the PHP user (0600):
# UPDATE_SSH_HOST=github.com
# UPDATE_SSH_KEY=/var/www/.ssh/your_deploy_key
# Leave empty (or absent) for automatic detection (git checkout → updater on).
# UPDATE_ENABLED=true forces the updater, UPDATE_ENABLED=false disables it.
UPDATE_ENABLED=
