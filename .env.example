# Environment template for Socly
# Copy to .env and adjust. The install wizard can also write this file.
# System / infrastructure only — association choices go in .env.user

APP_NAME=Socly
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=socly
DB_USERNAME=socly
DB_PASSWORD=

APP_LOCALE=it
SESSION_LIFETIME=120

# GitHub auto-update (SSH host alias recommended: github.com-socly)
UPDATE_REPO=git@github.com-socly:dadaloop82/socly.git
UPDATE_CHANNEL=main
UPDATE_ENABLED=true
