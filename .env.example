# Environment template for Socly
# Copy to .env and adjust. The install wizard can also write this file.
# System / infrastructure only — association choices go in .env.user

APP_NAME=Socly
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=socly
DB_USERNAME=socly
DB_PASSWORD=

APP_LOCALE=it
SESSION_LIFETIME=120

# Public SOCLY website (all app ↔ site API calls: news, platform, …)
# Prefer apex host (avoids www → apex redirect on API fetches).
SOCLY_SITE_URL=https://socly.it

# Release notifications (public HTTPS manifest — no tokens or SSH required)
UPDATE_NOTIFY=true
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/dadaloop82/socly_public/main/latest.json

# Optional one-click git install (requires SSH access to UPDATE_REPO)
UPDATE_REPO=git@github.com-socly:dadaloop82/socly.git
UPDATE_CHANNEL=main
UPDATE_ENABLED=false

# Optional: sealed GitHub Issues reporter (private repo only)
# Ciphertext lives in bootstrap/sealed_secrets.php (excluded from socly_public).
# SOCLY_SEAL_KEY decrypts it — never commit the seal key or a plaintext PAT.
SOCLY_SEAL_KEY=
GITHUB_ISSUES_TOKEN_ENC=
GITHUB_ISSUES_REPO=dadaloop82/socly
# Local override only (do not commit): GITHUB_ISSUES_TOKEN=
