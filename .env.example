# Environment template for Socly
# Copy to .env and adjust. The install wizard can also write this file.
# System / infrastructure only — association choices go in .env.user

APP_NAME=Socly
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=socly
DB_USERNAME=socly
DB_PASSWORD=

APP_LOCALE=it
SESSION_LIFETIME=120

# Public SOCLY website (all app ↔ website API calls: news, platform, bug reports, …)
# Prefer apex host (avoids www → apex redirect on API fetches).
# Keep the public site here: never point it to the domain where this instance is
# installed (that domain has no /api/news.php and would answer 404).
SOCLY_SITE_URL=https://socly.it
# Optional override: SOCLY_PLATFORM_API_URL=https://socly.it/api/platform.php
# Optional override: SOCLY_NEWS_API_URL=https://socly.it/api/news.php
# Manual + auto bug reports via platform relay (0 = hide UI / skip send)
SOCLY_REPORT_PROBLEMS=1

# Release notifications (public HTTPS manifest — no tokens or SSH required)
UPDATE_NOTIFY=true
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/dadaloop82/socly_public/main/latest.json

# One-click / scheduled update (sidebar "Install" button, bin/update.php --apply).
# Requires the app to be a git checkout whose `origin` remote is readable by the
# PHP/CLI user; migrations and field seeding then run automatically.
#   • installed from the public repository: no SSH key is needed (anonymous HTTPS read)
#   • internal/developer checkout: keep the SSH remote below
# UPDATE_REPO is only used to report the upstream "last commit" in the UI; the
# fetch/merge always uses the checkout's own `origin` remote.
# Nightly fully-automatic update:
#   15 4 * * * php /path/to/socly/bin/update.php --apply >> /path/to/socly/storage/logs/update.log 2>&1
UPDATE_REPO=git@github.com-socly:dadaloop82/socly.git
UPDATE_CHANNEL=main
UPDATE_ENABLED=false
